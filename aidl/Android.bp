aidl_interface {
    name: "vendor.qti.hardware.dsp",
    vendor_available: true,
    srcs: ["vendor/qti/hardware/dsp/*.aidl"],
    stability: "vintf",
    owner: "lineage",

    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    frozen: true,
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}
