cc_binary {
    name: "vendor.qti.hardware.dsp-service",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.qti.hardware.dsp-service.rc"],
    vintf_fragments: ["vendor.qti.hardware.dsp-service.xml"],
    srcs: ["service.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.qti.hardware.dsp-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
